VAULTWARDEN_VERSION=1.33.2
VAULTWARDEN_SERVER_HOSTNAME=vault.example.com

# Admin panel token (generate with: openssl rand -hex 32)
# Leave empty to disable admin panel
ADMIN_TOKEN=

# Registration
# Set to true to allow anyone to register (not recommended for production)
SIGNUPS_ALLOWED=false
# Comma-separated list of allowed email domains (e.g: example.com,example.org)
SIGNUPS_DOMAINS_WHITELIST=

# Email (SMTP)
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=smtp@mailtrap.io
SMTP_PASSWORD=
SMTP_FROM=vault@example.com
SMTP_FROM_NAME=Vaultwarden
